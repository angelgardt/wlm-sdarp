filters:
  and:
    - file.folder == "DBs/RESOURCES"
    - file.ext != "base"
views:
  - type: table
    name: All
    order:
      - file.name
      - citekey
      - type
      - author
      - title
      - subtitle
      - journal
      - year
      - volume
      - number
      - pages
      - month
      - note.note
      - annote
      - publisher
      - series
      - address
      - edition
      - editor
    sort: []
